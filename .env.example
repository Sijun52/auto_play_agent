# ── 사내 LLM 설정 (OpenAI-compatible) ─────────────────────────────────────────
OPENAI_BASE_URL=http://your-company-llm-server/v1
OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL=gpt-4

# ── OpenCode 서버 포트 ─────────────────────────────────────────────────────────
OPENCODE_PORT=4096

# ── 작업 대상 git 프로젝트 경로 ────────────────────────────────────────────────
PROJECT_DIR=C:/path/to/your/project

# ── task 파일 경로 (기본값: 현재 디렉토리의 tasks.md) ─────────────────────────
TASKS_FILE=C:/workspace/auto_play_agent/tasks.md

# ── PR 대상 베이스 브랜치 (main / master / development 등) ───────────────────
BASE_BRANCH=main

# ── GitHub Personal Access Token (PR 자동 생성용, repo 권한 필요) ─────────────
# 발급: GitHub → Settings → Developer settings → Personal access tokens
GITHUB_TOKEN=
